VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_SUBJECT="mailto:admin@driveapp.pl"

# Cron job (opcjonalne — czyszczenie wygasłych raportów)
CRON_SECRET="wygeneruj: openssl rand -base64 32"
