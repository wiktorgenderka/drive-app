# Baza danych (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[HASLO]@db.[REF].supabase.co:5432/postgres"

# NextAuth — oba aliasy są używane w kodzie
NEXTAUTH_SECRET="wygeneruj: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="(to samo co NEXTAUTH_SECRET)"
AUTH_URL="http://localhost:3000"

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1..."
MAPBOX_SERVER_TOKEN="sk.eyJ1..."

# Socket.IO — zostaw puste dla localhost, ustaw URL serwera na produkcji
NEXT_PUBLIC_SOCKET_URL=""

# SMTP (wysyłanie maili — reset hasła itp.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="twoj@gmail.com"
SMTP_PASS="haslo-aplikacji-gmail"
SMTP_FROM="Drive App <twoj@gmail.com>"

# Spotify (opcjonalne)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/spotify/callback"

# Web Push / VAPID (powiadomienia push)
# Generuj: npx web-push generate-vapid-keys
