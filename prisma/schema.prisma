generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ConvoyRole {
  OWNER
  MEMBER
}

enum ReportType {
  POLICE
  UNMARKED_POLICE
  SPEED_TRAP
  ACCIDENT
  OBSTACLE
  SPEED_CAMERA
}

enum FuelType {
  PETROL_95
  PETROL_98
  DIESEL
  LPG
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String
  password           String
  image              String?
  latitude           Float?
  longitude          Float?
  lastLocationUpdate DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  sentRequests     Friendship[]    @relation("FriendshipRequester")
  receivedRequests Friendship[]    @relation("FriendshipAddressee")
  convoyMembers    ConvoyMember[]
  ownedConvoys     Convoy[]
  reports          Report[]
  fuelPrices       FuelPrice[]
  routes           Route[]
  reportVotes         ReportVote[]
  spotifyToken        SpotifyToken?
  trips               Trip[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model SpotifyToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("spotify_tokens")
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("friendships")
}

model Convoy {
  id        String         @id @default(cuid())
  name      String
  ownerId   String
  destLat   Float?
  destLng   Float?
  destName  String?
  createdAt DateTime       @default(now())

  owner    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members  ConvoyMember[]
  routes   Route[]
  messages ConvoyMessage[]

  @@index([ownerId])
  @@map("convoys")
}

model ConvoyMessage {
  id        String   @id
  convoyId  String
  userId    String
  userName  String
  type      String   @default("text")
  message   String?
  audioData String?  @db.Text
  mimeType  String?
  duration  Int?
  edited    Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())

  convoy Convoy @relation(fields: [convoyId], references: [id], onDelete: Cascade)

  @@index([convoyId, createdAt])
  @@map("convoy_messages")
}

model ConvoyMember {
  id       String     @id @default(cuid())
  convoyId String
  userId   String
  role     ConvoyRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  convoy Convoy @relation(fields: [convoyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([convoyId, userId])
  @@map("convoy_members")
}

model Report {
  id          String     @id @default(cuid())
  type        ReportType
  latitude    Float
  longitude   Float
  description String?
  createdAt   DateTime   @default(now())
  expiresAt   DateTime
  confirmedAt DateTime?
  userId      String

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes ReportVote[]

  @@index([userId])
  @@index([expiresAt, latitude, longitude])
  @@map("reports")
}

model ReportVote {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  isUpvote  Boolean
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@map("report_votes")
}

model FuelStation {
  id        String      @id @default(cuid())
  name      String
  brand     String?
  address   String?
  latitude  Float
  longitude Float

  prices FuelPrice[]

  @@index([latitude, longitude])
  @@map("fuel_stations")
}

model FuelPrice {
  id        String   @id @default(cuid())
  stationId String
  fuelType  FuelType
  price     Float
  updatedAt DateTime @updatedAt
  userId    String

  station FuelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stationId, fuelType])
  @@map("fuel_prices")
}

model Route {
  id          String   @id @default(cuid())
  name        String
  description String?
  waypoints   Json
  createdAt   DateTime @default(now())
  userId      String
  convoyId    String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  convoy Convoy? @relation(fields: [convoyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("routes")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Trip {
  id          String   @id @default(cuid())
  userId      String
  vehicleId   String?
  convoyId    String?
  startedAt   DateTime
  endedAt     DateTime
  distanceKm  Float
  maxSpeedKmh Float
  avgSpeedKmh Float
  durationMin Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("trips")
}
