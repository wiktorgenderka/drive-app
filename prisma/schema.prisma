generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ConvoyRole {
  OWNER
  MEMBER
}

enum ReportType {
  POLICE
  UNMARKED_POLICE
  SPEED_TRAP
  ACCIDENT
  OBSTACLE
  SPEED_CAMERA
}

enum FuelType {
  PETROL_95
  PETROL_98
  DIESEL
  LPG
}

enum SpotKind {
  AUTO
  MANUAL
}

enum SpotVisibility {
  FRIENDS
  PUBLIC
}

enum XPEventType {
  TRIP_COMPLETED
  ROUTE_CREATED
  ROUTE_DRIVEN
  REPORT_CONFIRMED
  SPOT_CREATED
  CONVOY_JOINED
  FRIEND_ADDED
  POST_LIKED
  STREAK_BONUS
  ACHIEVEMENT_UNLOCKED
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum EventType {
  MEETUP
  TRACK_DAY
  CONVOY_EVENT
  CRUISE
  CAR_SHOW
  OTHER
}

enum AttendeeStatus {
  GOING
  MAYBE
  NOT_GOING
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String
  password           String
  image              String?
  latitude           Float?
  longitude          Float?
  speed              Float?
  lastLocationUpdate DateTime?
  carDisplay         String?
  bio                String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  sentRequests     Friendship[]    @relation("FriendshipRequester")
  receivedRequests Friendship[]    @relation("FriendshipAddressee")
  convoyMembers    ConvoyMember[]
  ownedConvoys     Convoy[]
  reports          Report[]
  fuelPrices       FuelPrice[]
  routes           Route[]
  routeTimes       RouteTime[]
  routeRatings        RouteRating[]
  reportVotes         ReportVote[]
  spotifyToken        SpotifyToken?
  trips               Trip[]
  passwordResetTokens PasswordResetToken[]
  posts               Post[]
  postLikes           PostLike[]
  postComments        PostComment[]
  spots               Spot[]
  spotParticipations  SpotParticipant[]
  userXP              UserXP?
  xpEvents            XPEvent[]
  achievements        UserAchievement[]
  streak              UserStreak?
  createdEvents       Event[]
  eventAttendees      EventAttendee[]
  vehicles            Vehicle[]

  @@map("users")
}

model SpotifyToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("spotify_tokens")
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("friendships")
}

model Convoy {
  id        String         @id @default(cuid())
  name      String
  ownerId   String
  destLat   Float?
  destLng   Float?
  destName  String?
  createdAt DateTime       @default(now())

  owner    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members  ConvoyMember[]
  routes   Route[]
  messages ConvoyMessage[]

  @@index([ownerId])
  @@map("convoys")
}

model ConvoyMessage {
  id        String   @id
  convoyId  String
  userId    String
  userName  String
  type      String   @default("text")
  message   String?
  audioData String?  @db.Text
  mimeType  String?
  duration  Int?
  edited    Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())

  convoy Convoy @relation(fields: [convoyId], references: [id], onDelete: Cascade)

  @@index([convoyId, createdAt])
  @@map("convoy_messages")
}

model ConvoyMember {
  id       String     @id @default(cuid())
  convoyId String
  userId   String
  role     ConvoyRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  convoy Convoy @relation(fields: [convoyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([convoyId, userId])
  @@map("convoy_members")
}

model Report {
  id          String     @id @default(cuid())
  type        ReportType
  latitude    Float
  longitude   Float
  description String?
  createdAt   DateTime   @default(now())
  expiresAt   DateTime
  confirmedAt DateTime?
  userId      String

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes ReportVote[]

  @@index([userId])
  @@index([expiresAt, latitude, longitude])
  @@map("reports")
}

model ReportVote {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  isUpvote  Boolean
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@map("report_votes")
}

model FuelStation {
  id        String      @id @default(cuid())
  name      String
  brand     String?
  address   String?
  latitude  Float
  longitude Float

  prices FuelPrice[]

  @@index([latitude, longitude])
  @@map("fuel_stations")
}

model FuelPrice {
  id        String   @id @default(cuid())
  stationId String
  fuelType  FuelType
  price     Float
  updatedAt DateTime @updatedAt
  userId    String

  station FuelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stationId, fuelType])
  @@map("fuel_prices")
}

model Route {
  id            String    @id @default(cuid())
  name          String
  description   String?
  waypoints     Json
  createdAt     DateTime  @default(now())
  userId        String
  convoyId      String?
  isPublic      Boolean   @default(false)
  publishedAt   DateTime?
  importedFromId String?
  avgRating     Float?
  ratingCount   Int       @default(0)

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  convoy         Convoy?       @relation(fields: [convoyId], references: [id], onDelete: SetNull)
  times          RouteTime[]
  ratings        RouteRating[]
  importedFrom   Route?        @relation("RouteImports", fields: [importedFromId], references: [id], onDelete: SetNull)
  imports        Route[]       @relation("RouteImports")

  @@index([userId, createdAt])
  @@index([isPublic, publishedAt])
  @@index([isPublic, avgRating, ratingCount])
  @@map("routes")
}

model RouteRating {
  id        String   @id @default(cuid())
  routeId   String
  userId    String
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([routeId, userId])
  @@index([routeId])
  @@map("route_ratings")
}

model RouteTime {
  id        String   @id @default(cuid())
  routeId   String
  userId    String
  seconds   Int
  createdAt DateTime @default(now())

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([routeId, seconds])
  @@index([userId, routeId])
  @@map("route_times")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Trip {
  id          String   @id @default(cuid())
  userId      String
  vehicleId   String?
  convoyId    String?
  startedAt   DateTime
  endedAt     DateTime
  distanceKm  Float
  maxSpeedKmh Float
  avgSpeedKmh Float
  durationMin Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("trips")
}

model Post {
  id           String   @id @default(cuid())
  userId       String
  content      String?
  imageData    String?
  latitude     Float?
  longitude    Float?
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments PostComment[]

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([likeCount])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("post_likes")
}

model Spot {
  id          String         @id @default(cuid())
  kind        SpotKind
  visibility  SpotVisibility
  latitude    Float
  longitude   Float
  title       String?
  description String?
  createdById String
  createdAt   DateTime       @default(now())
  expiresAt   DateTime
  closedAt    DateTime?

  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants SpotParticipant[]

  @@index([visibility, closedAt, expiresAt])
  @@index([createdById, createdAt])
  @@index([latitude, longitude])
  @@map("spots")
}

model SpotParticipant {
  id       String    @id @default(cuid())
  spotId   String
  userId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  spot Spot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spotId, userId])
  @@index([userId, leftAt])
  @@map("spot_participants")
}

model UserXP {
  id        String   @id @default(cuid())
  userId    String   @unique
  total     Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_xp")
}

model XPEvent {
  id        String      @id @default(cuid())
  userId    String
  type      XPEventType
  amount    Int
  meta      Json?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("xp_events")
}

model Achievement {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  description String
  emoji       String
  xpReward    Int               @default(0)
  rarity      AchievementRarity @default(COMMON)

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model UserStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveDate DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

model Event {
  id           String        @id @default(cuid())
  title        String
  description  String
  type         EventType
  date         DateTime
  endDate      DateTime?
  latitude     Float
  longitude    Float
  address      String
  maxAttendees Int?
  imageData    String?
  isPublic     Boolean       @default(true)
  createdById  String
  createdAt    DateTime      @default(now())

  createdBy  User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  attendees  EventAttendee[]

  @@index([date, latitude, longitude])
  @@index([createdById])
  @@map("events")
}

model EventAttendee {
  id        String         @id @default(cuid())
  eventId   String
  userId    String
  status    AttendeeStatus @default(GOING)
  createdAt DateTime       @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_attendees")
}

model Vehicle {
  id         String   @id @default(cuid())
  userId     String
  make       String
  model      String
  year       Int
  color      String?
  photos     String[]
  mods       String?
  horsepower Int?
  torque     Int?
  engine     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("vehicles")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("post_comments")
}
